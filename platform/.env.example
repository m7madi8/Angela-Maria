# Local only. Copy to .env and fill in a database you control.
# Do not point this at a production database.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:54329/angila_foundation

# Required before sign-in can send a link or accept one.
# Generate a long random value. Do not commit it.
AUTH_SECRET=

# Comma-separated admin emails. Matching is case-insensitive.
# An empty list refuses every session. There is no self-service registration.
ADMIN_EMAILS=

# Public origin of this application, with no path. Production must use https.
# Locally this must be the exact Local URL printed when the dev server starts.
# Example: http://localhost:3001
APP_ORIGIN=

# Optional. Pins `npm run dev` when port 3000 is already in use.
# Keep this in step with APP_ORIGIN.
# PORT=3001

# SMTP for the one-time sign-in link. Leave these empty to keep administration closed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
